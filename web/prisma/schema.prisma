generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Image {
  id           String   @id @default(cuid())
  originalUrl  String
  depthMapUrl  String?
  anaglyphUrl  String?
  fileName     String
  width        Int
  height       Int
  intensity    Float    @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("td_image")
}
