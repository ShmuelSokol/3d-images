// WARNING: DO NOT run prisma db push — shared DB with ocr-hebrew & 3rdBHMK.
// Use raw SQL migrations (see scripts/migrate.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  password             String
  imageCredits         Int      @default(50)
  plan                 String   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  images               Image[]
  couponRedemptions    CouponRedemption[]
  payments             Payment[]

  @@map("td_user")
}

model Image {
  id          String   @id @default(cuid())
  originalUrl String
  depthMapUrl    String?
  distanceMapUrl String?
  anaglyphUrl    String?
  stereogramUrl  String?
  sbsUrl         String?
  videoUrl    String?
  fileName    String
  width       Int
  height      Int
  intensity     Float    @default(10)
  colorMode     String   @default("dubois")
  fillOcclusion Boolean  @default(true)
  status        String   @default("pending")
  refunded      Boolean  @default(false)
  isPublic      Boolean  @default(false)
  publishedAt   DateTime?
  // Moderation. status: ok | flagged | appealed | cleared | removed
  // Anything not in (ok, cleared) is hidden from the library immediately.
  moderationStatus String  @default("ok")
  flagCount        Int     @default(0)
  hiddenAt         DateTime?
  appealText       String?
  appealedAt       DateTime?
  moderatedAt      DateTime?
  moderatorNote    String?
  flags            ImageFlag[]
  error       String?
  mediaType   String   @default("image")
  duration    Float?
  frameCount  Int?
  framesDone  Int      @default(0)
  formats      String   @default("anaglyph,stereogram,sbs")
  hiRes        Boolean  @default(false)
  startedAt    DateTime?
  processingMs Int?
  sessionId   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("td_image")
}

/// One report of a published result. `flaggerKey` is the reporter's user id
/// when logged in, else their session id — unique per image so one person
/// can't pile on, and so flag counts mean something.
model ImageFlag {
  id         String   @id @default(cuid())
  imageId    String
  image      Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  flaggerKey String
  reason     String
  detail     String?
  createdAt  DateTime @default(now())

  @@unique([imageId, flaggerKey])
  @@index([createdAt])
  @@map("td_image_flag")
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  credits        Int      @default(100)
  maxRedemptions Int      @default(1)
  timesRedeemed  Int      @default(0)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  redemptions    CouponRedemption[]

  @@map("td_coupon")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@map("td_coupon_redemption")
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  stripeSessionId String   @unique
  amount          Int
  credits         Int
  status          String   @default("pending")
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())

  @@map("td_payment")
}

model Ticket {
  id        String   @id @default(cuid())
  email     String
  subject   String
  message   String
  status    String   @default("open")
  userId    String?
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("td_ticket")
}
